{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Preparar proyecto Windows",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\.vscode\\prepare_windows.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "Iniciar emulador tablet",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/.vscode/start_tablet.ps1"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "never",
				"panel": "dedicated",
				"showReuseMessage": false
			}
		},
		{
			"label": "Ejecutar Flutter Windows",
			"type": "process",
			"command": "flutter",
			"args": [
				"run",
				"-d",
				"windows"
			],
			"options": {
				"cwd": "V:\\${workspaceFolderBasename}"
			},
			"dependsOn": "Preparar proyecto Windows",
			"dependsOrder": "sequence",
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"showReuseMessage": false
			}
		}
	]
}