{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Voxelcost3D: Windows",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}",
      "program": "lib/main.dart",
      "deviceId": "windows"
    },
    {
      "name": "Voxelcost3D: Android Tablet",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}",
      "program": "lib/main.dart",
      "preLaunchTask": "Iniciar emulador tablet",
      "deviceId": "emulator-5554",
      "args": [
        "--enable-software-rendering"
      ]
    }
  ]
}
