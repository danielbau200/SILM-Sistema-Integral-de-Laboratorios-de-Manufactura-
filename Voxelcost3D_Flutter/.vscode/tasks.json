{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Iniciar emulador tablet",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/.vscode/start_tablet.ps1"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "never",
				"panel": "dedicated",
				"showReuseMessage": false
			}
		},
		{
			"label": "Ejecutar Flutter Windows diagnóstico",
			"type": "shell",
			"command": "flutter",
			"args": [
				"run",
				"-d",
				"windows",
				"--verbose"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}